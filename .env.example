# PostgreSQL connection string (Replit dev DB in QA; a separate database in production)
DATABASE_URL=postgresql://user:password@localhost:5432/ghsqui

# Long random string used to sign session cookies and quiz start tokens
SESSION_SECRET=

# Set to "production" in Replit Deployment (enables Secure cookies)
NODE_ENV=

# Port the server listens on (defaults to 3000)
PORT=

# One-time secret for the first-admin bootstrap script (npm run make-admin).
# Set it only while bootstrapping, then remove it again.
ADMIN_BOOTSTRAP_SECRET=
